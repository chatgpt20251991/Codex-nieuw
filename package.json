{
  "name": "eubatterypassport-platform",
  "private": true,
  "version": "0.2.1",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @eubp/api & npm run dev --workspace @eubp/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @eubp/rules && python3 scripts/verify_v2.py",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace @eubp/api",
    "db:migrate": "npm run prisma:migrate --workspace @eubp/api",
    "db:deploy": "npm run prisma:deploy --workspace @eubp/api"
  }
}
