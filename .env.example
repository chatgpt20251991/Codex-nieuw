NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://eubp_runtime:eubp_runtime_local@localhost:5432/eubp?schema=public
DIRECT_DATABASE_URL=postgresql://eubp_migrator:eubp_migrator_local@localhost:5432/eubp?schema=public
# Used only by administrative setup scripts, never by the API.
DATABASE_ADMIN_URL=postgresql://postgres:eubp_local_admin@localhost:5432/eubp

# Authentication. Production must use oidc.
AUTH_MODE=dev
DEV_JWT_SECRET=replace-with-at-least-32-random-bytes
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Map the provider's API access-token claims; audience must identify this API.
OIDC_ORGANISATION_CLAIM=org_id
OIDC_ROLE_CLAIM=role
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_JWKS_COOLDOWN_MS=30000
OIDC_JWKS_CACHE_MAX_AGE_MS=600000

# Production always requires ClamAV and versioned evidence storage.
MALWARE_SCANNER=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_BYTES=104857600

# Per-process fallback limits; enforce shared limits in the deployment WAF.
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=120
# Browser CSP exact origins. Production must use HTTPS and rebuild the web app.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_EVIDENCE_UPLOAD_ORIGIN=http://localhost:9000

# Object storage. Local Docker uses MinIO; production should use an EU-region S3-compatible service.
S3_REGION=eu-central-1
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=eubp-evidence
S3_ACCESS_KEY=eubp-local
S3_SECRET_KEY=eubp-local-secret
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=900

# Stable public identifier base. Production MUST be HTTPS.
RESOLVER_BASE_URL=http://localhost:4000/v1/public/b

# Evidence extraction is deliberately pluggable. Results are suggestions, never auto-validated facts.
EVIDENCE_EXTRACTOR=disabled
EXTRACTION_WEBHOOK_URL=
EXTRACTION_WEBHOOK_SECRET=

# Regulatory feature flags are conservative by default.
BATTERY_SEMANTIC_CATALOGUE_AVAILABLE=false
REGISTRY_BATTERY_SUBMISSION_AVAILABLE=false
ARTICLE_77_9_ACCESS_ACT_FINAL=false

# Rule-set label recorded into every immutable passport version.
REGULATORY_RULESET_VERSION=EU-BR-2026.08
SUPPLIER_PORTAL_BASE_URL=http://localhost:3000/supplier
RESTRICTED_ACCESS_BASE_URL=http://localhost:3000/access
