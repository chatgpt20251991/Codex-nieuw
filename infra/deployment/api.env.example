# Proposed production settings. Empty fields MUST be supplied in the hosting secret store.
# These addresses are proposals, not evidence that DNS or services exist.
NODE_ENV=production
PORT=4000
AUTH_MODE=oidc
WEB_ORIGIN=https://app.eubatterypassport.nl
DATABASE_URL=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=https://api.eubatterypassport.nl
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ORGANISATION_CLAIM=https://eubatterypassport.nl/organisation_id
OIDC_ROLE_CLAIM=https://eubatterypassport.nl/role
S3_REGION=eu-central-1
S3_BUCKET=
# Use approved runtime IAM credentials only. Do not add bucket-administration permissions.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_URL_TTL_SECONDS=300
MALWARE_SCANNER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
CLAMAV_MAX_BYTES=104857600
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=120
RESOLVER_BASE_URL=https://api.eubatterypassport.nl/v1/public/b
SUPPLIER_PORTAL_BASE_URL=https://app.eubatterypassport.nl/supplier
RESTRICTED_ACCESS_BASE_URL=https://app.eubatterypassport.nl/access
EVIDENCE_EXTRACTOR=disabled
BATTERY_SEMANTIC_CATALOGUE_AVAILABLE=false
REGISTRY_BATTERY_SUBMISSION_AVAILABLE=false
ARTICLE_77_9_ACCESS_ACT_FINAL=false
REGULATORY_RULESET_VERSION=EU-BR-2026.08
