# Include ONCE directly inside the existing nginx.conf http { ... } block.
# This file contains no listener, TLS certificate, upstream or real-IP trust rule.
# Review and test it in the actual dedicated API gateway before activation.

# Empty map keys are intentionally not counted: this budget applies to /v1,
# not unrelated virtual hosts' web assets. Case variants remain limited.
map $uri $eubp_api_limit_key {
    default "";
    ~*^/v1(/|$) $binary_remote_addr;
}

map $uri $eubp_sensitive_limit_key {
    default "";
    ~*^/v1/(auth|supplier-portal|restricted-access|access-grants)(/|$) $binary_remote_addr;
}

# These categories avoid logging public identifiers, tenant IDs or tokens.
map $uri $eubp_route_class {
    default other;
    ~*^/v1/public/b/[^/]+(/qr[.]svg)?/?$ public_passport;
    ~*^/v1/supplier-portal(/|$) supplier_capability;
    ~*^/v1/restricted-access(/|$) restricted_capability;
    ~*^/v1/access-grants(/|$) access_grant;
    ~*^/v1/auth(/|$) auth;
    ~*^/v1/evidence(/|$) evidence;
    ~*^/v1/health/?$ health;
    ~*^/v1(/|$) api;
}

# Reviewable starting limits, not an approved production capacity calculation.
# Shared between workers of this NGINX instance; NOT shared across replicas.
limit_req_zone $eubp_api_limit_key zone=eubp_api:10m rate=600r/m;
limit_req_zone $eubp_sensitive_limit_key zone=eubp_sensitive:10m rate=120r/m;
limit_req zone=eubp_api burst=30 nodelay;
limit_req zone=eubp_sensitive burst=10 nodelay;
limit_req_status 429;
limit_req_log_level warn;

# A server/location defining ANY limit_req stops inheriting BOTH defaults.
# Repeat both directives there if an existing route overrides the defaults.

# Select this format in the actual server block with:
# access_log <approved-local-log-path> eubp_security_json;
# Do not add $request, $request_uri, $args, capability/auth headers or bodies.
log_format eubp_security_json escape=json
    '{"event":"edge_request","edgeRequestId":"$request_id",'
    '"apiRequestId":"$upstream_http_x_request_id",'
    '"routeClass":"$eubp_route_class","method":"$request_method",'
    '"status":$status,"requestTime":$request_time,'
    '"rateLimit":"$limit_req_status"}';
